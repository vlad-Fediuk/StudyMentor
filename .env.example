POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=study_mentor
POSTGRES_PORT=55432
ConnectionStrings__DefaultConnection=Host=localhost;Port=55432;Database=study_mentor;Username=postgres;Password=change_me_postgres_password;Maximum Pool Size=20;Minimum Pool Size=5;

Jwt__Campus__Key=change_me_super_secret_jwt_key_at_least_32_chars_long
Jwt__Campus__Issuer=StudyMentorApi
Jwt__Campus__Audience=StudyMentorClient
Jwt__Campus__LifetimeMinutes=60

Jwt__Microsoft__Authority=https://login.microsoftonline.com/your-tenant-id/v2.0
Jwt__Microsoft__Audience=your-client-id

NVIDIA_API_KEY=change_me_nvidia_api_key

RateLimiting__Enabled=true
RateLimiting__PermitLimit=100
RateLimiting__WindowSeconds=60

Resilience__TimeoutSeconds=30
Resilience__Retry__MaxAttempts=3
Resilience__CircuitBreaker__FailureRatio=0.5
Resilience__CircuitBreaker__BreakSeconds=30
FaultInjection__Enabled=false

Caching__Enabled=true
Caching__DefaultTtlSeconds=300
